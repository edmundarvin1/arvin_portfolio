# Backend Environment Variables
# Copy this to .env and fill in your actual values

# Flask
FLASK_ENV=development
FLASK_DEBUG=True

# Trading API (add your credentials)
TRADING_API_KEY=your_trading_api_key_here
TRADING_API_URL=https://api.yourtrading.com/v1

# Google Sheets
GOOGLE_SHEETS_CREDS=path/to/credentials.json
GYM_SPREADSHEET_ID=your_spreadsheet_id_here
